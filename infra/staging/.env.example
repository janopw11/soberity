# Copy to .env on the STAGING host only. All values must be supplied.
# A DNS hostname (no protocol, port or path), e.g. staging.example.org.
STAGING_HOST=
ACME_EMAIL=
# Image produced from a reviewed commit; use an immutable tag or digest.
BACKEND_IMAGE=
# Absolute paths outside the checkout. Do not paste credentials into env.
DB_PASSWORD_FILE=
FIREBASE_CREDENTIALS_FILE=
SOBERITY_FIREBASE_PROJECT_ID=
# Absolute directory containing the Expo static export for this environment.
WEB_DIST_PATH=
