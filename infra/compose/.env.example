# Copy to infra/compose/.env (git-ignored) and set a local-only password. Never commit real values.
SOBERITY_DB_PASSWORD=
SOBERITY_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Host port for PostgreSQL (change if 5432 is already used on this machine).
SOBERITY_POSTGRES_PORT=5432
