# Backend API base URL. Web / iOS Simulator use localhost.
# Android Emulator must use http://10.0.2.2:8080 instead.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Firebase web configuration for the dev project (public client values, not secrets).
# Leave empty to run without auth; sign-in then reports "not configured".
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional local Firebase Auth emulator, e.g. http://localhost:9099.
# Android Emulator must use http://10.0.2.2:9099 instead.
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=

# Optional allow-listed continueUrl for verification e-mails (e.g. https://HOST/sign-in).
# This is not the action link; that is set in the Firebase console template.
EXPO_PUBLIC_FIREBASE_EMAIL_CONTINUE_URL=

# Optional allow-listed continueUrl for password reset e-mails (e.g. https://HOST/sign-in).
# This is not the action link; that is set in the Firebase console template.
EXPO_PUBLIC_FIREBASE_PASSWORD_RESET_CONTINUE_URL=

# EXPO_PUBLIC_* values are bundled into the client. Never put credentials or service keys here.
