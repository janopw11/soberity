{
  "expo": {
    "name": "Soberity Dev",
    "slug": "soberity",
    "version": "0.0.1",
    "scheme": "soberity-dev",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.soberity.app.dev",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleLocalizations": ["en", "pl"]
      }
    },
    "android": {
      "package": "com.soberity.app.dev"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "Soberity"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      "expo-dev-client",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Soberity to find nearby alcohol-free events during your visit. Your coordinates are not saved.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "isAndroidMotionActivityEnabled": false
        }
      ]
    ],
    "locales": {
      "en": "./locales/en.json",
      "pl": "./locales/pl.json"
    }
  }
}
