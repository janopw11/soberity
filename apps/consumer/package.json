{
  "name": "@soberity/consumer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "expo start --dev-client",
    "web": "expo start --web",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "eslint app src *.ts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform web --max-workers 2",
    "export:native": "expo export --platform ios --platform android --max-workers 2 --output-dir dist/native",
    "test:web": "node ../../scripts/test-web-e2e.mjs",
    "test:unit": "jest",
    "eas-build-pre-install": "node ../../scripts/check-client-env.mjs"
  },
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@soberity/design-tokens": "workspace:*",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-image": "3.32.2",
    "@tiptap/extension-text-align": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.28",
    "expo-status-bar": "~58.0.4",
    "firebase": "^13.1.0",
    "i18next": "26.5.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.1.9",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@playwright/test": "1.64.1",
    "@testing-library/react-native": "14.1.0",
    "@types/node": "26.6.6",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.23",
    "jest": "30.5.2",
    "jest-expo": "~58.0.13",
    "test-renderer": "1.3.0"
  }
}
