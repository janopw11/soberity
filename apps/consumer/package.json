{
  "name": "@soberity/consumer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "expo start --dev-client",
    "web": "expo start --web",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "eslint app src *.ts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "build": "expo export --platform web --max-workers 2",
    "export:native": "expo export --platform ios --platform android --max-workers 2 --output-dir dist/native",
    "test:web": "playwright test"
  },
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~58.0.21",
    "expo-router": "~58.0.28",
    "expo-linking": "~58.0.15",
    "expo-constants": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-dev-client": "~58.0.17",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "~0.21.4",
    "react-native-screens": "~4.30.0",
    "react-native-safe-area-context": "~5.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@playwright/test": "1.64.1"
  }
}
