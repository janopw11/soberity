# Local template. Spring does not load this file automatically.
SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/soberity
SPRING_DATASOURCE_USERNAME=soberity
SOBERITY_DB_PASSWORD=
SOBERITY_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
SOBERITY_FIREBASE_PROJECT_ID=demo-soberity
# For local demo Auth only; REMOVE this variable for a real Firebase project.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# For a real dev project, use ADC outside the repo; never paste service keys here.
# GOOGLE_APPLICATION_CREDENTIALS=/ABSOLUTE/PRIVATE/PATH/firebase.json
# Staging uses infra/staging/.env.example and mounted credential/password files.
